# Copy to `.env.local` (git-ignored) to override. Create React App only exposes
# variables prefixed with REACT_APP_, and inlines them at build time.

# Difficulty the board starts on. One of: easy | medium | hard.
# Controls how many cells the generator carves out (40 / 48 / 54 blanks).
# An unrecognised value throws at startup instead of falling back silently.
REACT_APP_DEFAULT_DIFFICULTY=easy
